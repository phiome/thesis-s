# ── Choose ONE provider ─────────────────────────────
# PROVIDER=gemini      -> free tier (Google AI Studio)
# PROVIDER=anthropic   -> your $100 Anthropic credit (better data protection)
PROVIDER=gemini

# ── Google Gemini (free tier) ───────────────────────
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Anthropic (Claude Haiku) ────────────────────────
# Get a key at: https://console.anthropic.com/  (Settings -> API Keys)
ANTHROPIC_API_KEY=paste-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5

# Server port (Render/Railway set this automatically)
PORT=3000
